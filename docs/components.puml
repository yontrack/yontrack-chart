@startuml

package namespace {
    database postgres
    component ontrack
    component "next-ui" as nextUI
    component rabbitMQ

    package "keycloak <optional>" as keycloak-package {
        database "postgres-keycloak"
        component keycloak
    }
}

nextUI --> ontrack: 8080
ontrack --> postgres: 5432
ontrack --> rabbitMQ

keycloak --> "postgres-keycloak": 5432

ontrack --> keycloak: 8080 (jwt)
nextUI --> keycloak: 8080 (oidc)

interface ingress

ingress --> nextUI: 3000 (/)
ingress --> keycloak: 8080 (/keycloak => /keycloak)
ingress --> ontrack: 8080 (/graphql, /hook, /rest/extension/audit-trail)

interface "ingress (uploads)" as uploadsIngress

uploadsIngress --> nextUI: 3000 (/api/protected/uploads/audit-trail/validation-runs)
uploadsIngress --> ontrack: 8080 (/rest/extension/audit-trail/validation-runs)

cloud "elasticsearch <optional, external>" as elasticSearch
ontrack ..> elasticSearch: metrics export

@enduml